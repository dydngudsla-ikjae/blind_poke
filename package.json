{
  "name": "blindpoke",
  "version": "1.0.0",
  "description": "가려진 포켓몬을 단서를 조회해 정체를 맞히는 추리 게임. 블라인드삼국의 \"가명 + 정체 추리\"를 포켓몬으로 옮긴 코어 루프.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5175",
    "build": "tsc -b && vite build && node scripts/copy-game-data.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4175",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:smoke": "node tests/smoke.mjs",
    "test:base-smoke": "node tests/base-smoke.mjs",
    "test:map-smoke": "node tests/map-smoke.mjs",
    "test:early-campaign": "node tests/early-campaign.mjs",
    "test:starting-region": "node tests/starting-region.mjs",
    "test:battle-rules": "node tests/battle-rules.mjs",
    "test:later-regions": "node tests/later-regions.mjs",
    "test:campaign": "node tests/campaign-playthrough.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shaders": "^4.0.7",
    "zod": "^4.4.3"
  }
}
